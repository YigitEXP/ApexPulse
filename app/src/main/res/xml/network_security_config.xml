<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Varsayılan olarak tüm HTTP (Cleartext) trafiğini engelle, yalnızca TLS 1.2/1.3 HTTPS zorunlu kıl -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Yalnızca araç içi Wi-Fi ELM327 adaptörünün yerel IP'sine (192.168.0.10) soket izni ver -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.0.10</domain>
    </domain-config>
</network-security-config>
